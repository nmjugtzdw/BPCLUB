# Copy to .env and fill in locally. Never commit .env.
APP_ENV=local
APP_DEBUG=true
TIMEZONE=UTC
LOG_PATH=storage/logs/app.log

# Use an isolated development database and a dedicated least-privilege account.
# Do not point this at a production database or reuse production credentials.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=kwl_dev_test
DB_USER=kwl_dev
DB_PASS=
DB_CHARSET=utf8mb4
